@code {
    [SupplyParameterFromForm]
    private Appointment Appointment { get; set; } = new();

    
    private List<Pet> Pets { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        Pets = await context.Pet
            .Where(p => !p.IsAdopted)
            .ToListAsync();
    }

    // To protect from overposting attacks, see
    // https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddAppointment()
    {
        if (Appointment.PetId == 0)
            return;

        using var context = DbFactory.CreateDbContext();

        // Get logged-in user
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var identityUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrEmpty(identityUserId))
            return;

        // Find the Customer linked to this Identity user
        var customerId = await context.Customer
            .Where(c => c.IdentityUserId == identityUserId)
            .Select(c => c.Id)
            .FirstOrDefaultAsync();

        if (customerId == 0)
            return;

        // Set the appointment ownership + defaults
        Appointment.CustomerId = customerId;
        Appointment.Status = AppointmentStatus.Pending;

        context.Appointment.Add(Appointment);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/appointments");
    }

}

