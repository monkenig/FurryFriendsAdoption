@page "/petcategories/details"
@using Microsoft.EntityFrameworkCore
@using FurryFriendsAdoption.Domain
@using System.Security.Claims
@inject IDbContextFactory<FurryFriendsAdoption.Data.FurryFriendsAdoptionContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Category Details</PageTitle>

<h1>Category Details</h1>

<div>
    <h2>Pet Category</h2>
    <hr />

    @if (petcategory is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@petcategory.Name</dd>

            <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@petcategory.DateCreated</dd>

            <dt class="col-sm-2">DateUpdated</dt>
            <dd class="col-sm-10">@petcategory.DateUpdated</dd>

            <dt class="col-sm-2">CreatedBy</dt>
            <dd class="col-sm-10">@petcategory.CreatedBy</dd>

            <dt class="col-sm-2">UpdatedBy</dt>
            <dd class="col-sm-10">@petcategory.UpdatedBy</dd>
        </dl>

        <hr />
        <h3>Pets in this Category</h3>

        @if (Pets is null)
        {
            <p><em>Loading pets...</em></p>
        }
        else if (!Pets.Any())
        {
            <p>No pets found in this category.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Species</th>
                        <th>Breed</th>
                        <th>Age</th>
                        <th>Gender</th>
                        <th>Vaccinated</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Pets)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.Species</td>
                            <td>@p.Breed</td>
                            <td>@p.Age</td>
                            <td>@p.Gender</td>
                            <td>@(p.IsVaccinated ? "Yes" : "No")</td>
                            <td>@(p.IsAdopted ? "Adopted" : "Available")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="mt-3">
            <a href="@($"/petcategories/edit?id={petcategory.Id}")">Edit</a>
            |
            <a href="/petcategories">Back to List</a>
        </div>
    }
</div>

@code {
    private PetCategory? petcategory;
    private List<Pet>? Pets;

    private bool IsAdmin;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Role check
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        IsAdmin = user.IsInRole("Administrator");

        using var context = DbFactory.CreateDbContext();

        petcategory = await context.PetCategory.FirstOrDefaultAsync(m => m.Id == Id);
        if (petcategory is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        // Load pets for this category
        var query = context.Pet
            .AsNoTracking()
            .Where(p => p.PetCategoryId == Id);

        // Users only see available pets
        if (!IsAdmin)
            query = query.Where(p => !p.IsAdopted);

        Pets = await query
            .OrderBy(p => p.Name)
            .ToListAsync();
    }
}
